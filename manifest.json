      "learnable_patterns": [
        "consulting-style visual explanation",
        "action titles",
        "founder-led narrative",
        "formula and takeaway cards",
        "process explanation from a plant visit"
      ]
    },
    {
      "id": "concord-foods",
      "kind": "production-case-study",
      "resources": [
        {"path": "sources/concord-foods/story/film-brief.md", "role": "approved-storyboard"},
        {"path": "sources/concord-foods/story/narration-script.md", "role": "voiceover-contract"},
        {"path": "sources/concord-foods/workflow/visual-system.md", "role": "visual-style-system"},
        {"path": "sources/concord-foods/workflow/film-plan.md", "role": "production-workflow"},
        {"path": "sources/concord-foods/composition/frames-01-03/index.html", "role": "editable-scene"},
        {"path": "sources/concord-foods/composition/frames-01-03/lib/opening.js", "role": "scene-timeline-and-render-logic"},
        {"path": "sources/concord-foods/composition/rough-cut/film parts.js", "role": "assembly-plan"},
        {"path": "sources/concord-foods/shared/factory-model.js", "role": "reusable-3d-scene-model"},
